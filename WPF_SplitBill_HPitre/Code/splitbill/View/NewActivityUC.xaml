<UserControl
    x:Class="splitbill.View.NewActivityUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:splitbill.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:splitbill.Model"
    xmlns:viewmodels="clr-namespace:splitbill.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:NewActivityVM}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    >

    <!--  Background Gradient  -->
    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#F0EFFF" />
                <GradientStop Offset="0.5" Color="#FAF0FF" />
                <GradientStop Offset="1" Color="#EFF6FF" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--#region  Header  : Contextual text et Btn Retour-->
            <Border Grid.Row="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        FontFamily="Segoe UI Light"
                        FontSize="26"
                        Foreground="#2D2D3A"
                        Text="Nouvelle activité" />

                    <!--  Bouton de navigation. Dans ce cas, Retour mène à overview  -->
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Command="{Binding ReturnToOverviewCommand}"
                        Content="Retour"
                        Style="{StaticResource SecondaryButton}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="#9898B8"
                        Text="Créez une activité et ajoutez des participants" />
                </Grid>
            </Border>

            <!--#endregion-->

            <!--  Main Card  -->
            <Border
                Grid.Row="2"
                Padding="28,24"
                Background="White"
                CornerRadius="16"
                Effect="{StaticResource CardShadow}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--#region  Left Column: Nom/Desc/Créer Activiter btn-->
                    <StackPanel Grid.Column="0">

                        <!--  Activity Name  -->
                        <Label Content="NOM DE L'ACTIVITÉ" Style="{StaticResource LabelStyle}" />
                        <TextBox Style="{StaticResource InputStyle}" Text="{Binding ActivityName}" />
                        <!--  Activity Name  -->
                        <Label Content="DESCRIPTION DE L'ACTIVITÉ" Style="{StaticResource LabelStyle}" />
                        <TextBox Style="{StaticResource InputStyle}" Text="{Binding ActivityDescription}" />

                    </StackPanel>

                    <!--  btn Submit  -->
                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Command="{Binding CreateActivityCommand}"
                        Content="✓  Créer l'activité"
                        Style="{StaticResource PrimaryButton}" />
                    <StackPanel />

                    <!--#endregion-->

                    <!--#region  Right Column: Participants List-->
                    <local:DualListUC
                        Grid.Column="1"
                        Margin="24,0,0,0"
                        AssignAllCommand="{Binding AssignAllCommand}"
                        AssignSelectedCommand="{Binding AssignSelectedCommand}"
                        AssignedCount="{Binding AssignedParticipants.Count}"
                        AssignedItems="{Binding AssignedParticipants}"
                        AvailableItems="{Binding AvailableParticipants}"
                        LeftTitle="PARTICIPANTS"
                        RemoveAllCommand="{Binding RemoveAllCommand}"
                        RemoveSelectedCommand="{Binding RemoveSelectedCommand}"
                        RightTitle="ASSIGNÉS">

                        <local:DualListUC.LeftColumns>
                            <GridViewColumnCollection>
                                <GridViewColumn
                                    Width="160"
                                    DisplayMemberBinding="{Binding Username}"
                                    Header="Sobriquet" />
                            </GridViewColumnCollection>
                        </local:DualListUC.LeftColumns>

                        <local:DualListUC.RightColumns>
                            <GridViewColumnCollection>
                                <GridViewColumn
                                    Width="160"
                                    DisplayMemberBinding="{Binding Username}"
                                    Header="Sobriquet" />
                            </GridViewColumnCollection>
                        </local:DualListUC.RightColumns>

                    </local:DualListUC>
                    <!--#endregion-->

                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>