<UserControl
    x:Class="splitbill.View.OverviewUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:splitbill.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:splitbill.Model"
    xmlns:viewmodels="clr-namespace:splitbill.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:OverviewVM}"
    Background="Honeydew"
    mc:Ignorable="d">

    <!--  Fond de la page  -->
    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#F0EFFF" />
                <GradientStop Offset="0.5" Color="#FAF0FF" />
                <GradientStop Offset="1" Color="#EFF6FF" />
            </LinearGradientBrush>
        </Border.Background>

        <!--  Grille de la page  -->
        <Grid Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--#region  Header  : Contextual text et Btn Retour-->
            <Border Grid.Row="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        FontFamily="Segoe UI Light"
                        FontSize="26"
                        Foreground="#2D2D3A"
                        Text="Vue d'ensemble" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="10,0"
                        FontFamily="Segoe UI Light"
                        FontSize="26"
                        Foreground="#2D2D3A"
                        Text="{Binding User.Username}" />

                    <!--  Bouton Deconnexion (TODO)  -->
                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Command="{Binding Logout_Command}"
                        Content="Déconnexion"
                        Style="{StaticResource SecondaryButton}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="#9898B8"
                        Text="Résumé financier et activités créées" />
                </Grid>
            </Border>

            <!--#endregion-->

            <Border
                Grid.Row="1"
                Margin="0,10,0,0"
                Padding="28,10"
                Background="White"
                CornerRadius="16"
                Effect="{StaticResource CardShadow}">

                <StackPanel>

                    <!--  SUMMARY CARDS  -->

                    <!--#region Header RÈGLEMENTS-->
                    <WrapPanel>
                        <Label
                            VerticalAlignment="Center"
                            Content="RÈGLEMENTS"
                            Style="{StaticResource LabelStyle}" />

                        <!--  Bouton de navigation : CommandParameters = Vers  où le bouton mène. Dans ce cas, +  mène à NewActivity  -->
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{Binding NewRefundCommand}"
                            Content="💲PAYER"
                            Style="{StaticResource TernaryButton}" />

                    </WrapPanel>
                    <!--#endregion-->

                    <!--#region  Cards À REMBOURSER / REMBOURSÉ-->
                    <Grid Grid.Row="2" Margin="0,10,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  A REMBOURSER  -->
                        <Border
                            Padding="10"
                            Background="White"
                            CornerRadius="16"
                            Effect="{StaticResource CardShadow}">
                            <Grid>
                                <WrapPanel>
                                    <Label Content="À REMBOURSER" Style="{StaticResource LabelStyle}" />

                                </WrapPanel>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Foreground="Red"
                                    Style="{StaticResource ValueStyle}"
                                    Text="{Binding DebtAmount, StringFormat=C}" />
                            </Grid>
                        </Border>

                        <!--  REMBOURSEMENTS FAITS  -->
                        <Border
                            Grid.Column="1"
                            Margin="20,0,0,0"
                            Padding="10"
                            Background="White"
                            CornerRadius="16"
                            Effect="{StaticResource CardShadow}">
                            <Grid>
                                <WrapPanel>
                                    <Label Content="REMBOURSÉ" Style="{StaticResource LabelStyle}" />

                                </WrapPanel>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Foreground="Green"
                                    Style="{StaticResource ValueStyle}"
                                    Text="{Binding RefundAmount, StringFormat=C}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <!--#endregion-->

                    <!--#region Header ACTIVITÉS-->
                    <Border>
                        <WrapPanel>
                            <Label
                                VerticalAlignment="Center"
                                Content="ACTIVITÉS"
                                Style="{StaticResource LabelStyle}" />

                            <!--  Bouton de navigation : CommandParameters = Vers  où le bouton mène. Dans ce cas, +  mène à NewActivity  -->
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{Binding NewActivityCommand}"
                                Content="➕ AJOUTER"
                                Style="{StaticResource TernaryButton}" />

                        </WrapPanel>

                    </Border>
                    <!--#endregion-->

                    <!--#region LIST ACTIVITÉS-->
                    <ListView
                        Height="200"
                        Margin="0,10,0,0"
                        d:ItemsSource="{d:SampleData ItemCount=5}"
                        ItemsSource="{Binding UserActivities}"
                        Style="{StaticResource ListViewStyle}">

                        <ListView.View>

                            <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">

                                <GridViewColumn Width="30" Header="Rôle">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock ToolTip="Vous êtes propriétaire de cette dépense">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource OwnerToCrownConverter}">
                                                        <!--  Mettre le "DataContext" à l'activité de la row actuelle  -->
                                                        <Binding />
                                                        <!--  User from MainVM  -->
                                                        <Binding Path="DataContext.User" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn
                                    Width="100"
                                    DisplayMemberBinding="{Binding Name}"
                                    Header="Nom activité" />
                                <!--  Ajouter couronne ou autre icone pour owner  -->

                                <GridViewColumn
                                    Width="120"
                                    DisplayMemberBinding="{Binding TotalAmount}"
                                    Header="Total dépenses" />

                                <GridViewColumn Width="120" Header="👥">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Width="110"
                                                Height="20"
                                                Cursor="Hand"
                                                Text="{Binding Participants.Count, StringFormat={}{0} Personnes}">
                                                <TextBlock.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel>
                                                            <TextBlock
                                                                Margin="0,0,0,4"
                                                                FontWeight="Bold"
                                                                Text="Participants:" />
                                                            <ItemsControl ItemsSource="{Binding Participants}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Username}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="100" Header="Statut">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                                        <Setter Property="Text" Value="En cours" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Terminée" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="100" Header="💳">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock ToolTip="➕ : Ce qu'on vous doit, ➖ : Ce que vous devez">
                                                <TextBlock.Text>
                                                    <!--  Ajouter le +  -->
                                                    <!--  TODO: Le converter est probablement inutile et je devrais l'enlever même si il m'a pris du temps à faire et j'ai de la misère à m'en défaire  -->
                                                    <MultiBinding Converter="{StaticResource UserBalanceToTextConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.User" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>

                                                <TextBlock.Foreground>
                                                    <!--  Balance text color conversion  -->
                                                    <MultiBinding Converter="{StaticResource BalanceToColorConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.User" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Action">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Command="{Binding DataContext.OpenActivityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TernaryButton}">
                                                <!--  Passer l'activité de la row actuelle en paramètre ({})  -->

                                                <Button.Content>
                                                    <MultiBinding Converter="{StaticResource EyeIconConverter}">
                                                        <Binding />
                                                        <!--  the Activity  -->
                                                        <Binding Path="DataContext.EyeIcons" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </Button.Content>

                                            </Button>

                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!--  rouge neg, vert pos, gris null/0  -->

                            </GridView>
                        </ListView.View>
                    </ListView>
                    <!--#endregion-->
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>