<UserControl
    x:Class="splitbill.View.NewExpenseUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:splitbill.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:splitbill.Model"
    xmlns:viewmodels="clr-namespace:splitbill.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:NewExpenseVM}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Honeydew"
    mc:Ignorable="d">

    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#F0EFFF" />
                <GradientStop Offset="0.5" Color="#FAF0FF" />
                <GradientStop Offset="1" Color="#EFF6FF" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--#region  Header-->
            <StackPanel Grid.Row="0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <TextBlock
                        FontFamily="Segoe UI Light"
                        FontSize="26"
                        FontWeight="Light"
                        Foreground="#2D2D3A"
                        Text="Nouvelle dépense" />

                    <!--  Bouton de navigation : Dans ce cas, Retour mène à overview  -->
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Command="{Binding ReturnToConsultCommand}"
                        Content="Retour"
                        Style="{StaticResource SecondaryButton}" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        FontFamily="Segoe UI"
                        FontSize="13"
                        Foreground="#9898B8"
                        Text="Enregistrez une dépense et assignez-la à un ou plusieurs participants" />
                </Grid>
            </StackPanel>
            <!--#endregion-->

            <!--  Main Card  -->
            <Border
                Grid.Row="2"
                Padding="28,24"
                Background="White"
                CornerRadius="16"
                Effect="{StaticResource CardShadow}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <!--#region LEFT: Titre/Desc/Amount/Ajouter-->
                    <StackPanel Grid.Column="0">

                        <Label Content="TITRE" Style="{StaticResource LabelStyle}" />
                        <TextBox Style="{StaticResource InputStyle}" Text="{Binding ExpenseName}" />

                        <Label Content="POUR QUOI" Style="{StaticResource LabelStyle}" />
                        <TextBox Style="{StaticResource InputStyle}" Text="{Binding ExpenseDescription}" />

                        <Border
                            Height="1"
                            Margin="0,16,0,16"
                            Background="#F0F0F5" />

                        <Label Content="MONTANT ($)" Style="{StaticResource LabelStyle}" />
                        <TextBox
                            LostFocus="Montant_LostFocus"
                            PreviewTextInput="MoneyOnly"
                            Style="{StaticResource InputStyle}"
                            Text="{Binding ExpenseAmount, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!--  btn Submit  -->
                    <Button
                        x:Name="BtnSave"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding CreateExpenseCommand}"
                        Content="✓  Ajouter la dépense"
                        Cursor="Hand"
                        Style="{StaticResource PrimaryButton}" />

                    <!--#endregion-->

                    <!--  TODO: AJOUTER "PART déjà payée" comme field dans ASSIGNÉS, ou quelque chose dans le genre  -->
                    <!--#region RIGHT : DualList Participants de la dépense-->
                    <local:DualListUC
                        Grid.RowSpan="2"
                        Grid.Column="2"
                        Padding="20,0,0,0"
                        AssignAllCommand="{Binding AssignAllCommand}"
                        AssignSelectedCommand="{Binding AssignSelectedCommand}"
                        AssignedCount="{Binding AssignedParticipants.Count}"
                        AssignedItems="{Binding AssignedParticipants}"
                        AvailableItems="{Binding AvailableParticipants}"
                        LeftTitle="PARTICIPANTS"
                        RemoveAllCommand="{Binding RemoveAllCommand}"
                        RemoveSelectedCommand="{Binding RemoveSelectedCommand}"
                        RightTitle="ASSIGNÉS">

                        <local:DualListUC.LeftColumns>
                            <GridViewColumnCollection>
                                <GridViewColumn
                                    Width="160"
                                    DisplayMemberBinding="{Binding Username}"
                                    Header="Sobriquet" />
                            </GridViewColumnCollection>
                        </local:DualListUC.LeftColumns>

                        <local:DualListUC.RightColumns>
                            <GridViewColumnCollection>
                                <GridViewColumn
                                    Width="160"
                                    DisplayMemberBinding="{Binding Username}"
                                    Header="Sobriquet" />
                            </GridViewColumnCollection>
                        </local:DualListUC.RightColumns>

                    </local:DualListUC>
                    <!--#endregion-->

                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

