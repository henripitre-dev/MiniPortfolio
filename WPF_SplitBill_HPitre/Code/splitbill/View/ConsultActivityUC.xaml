<UserControl
    x:Class="splitbill.View.ConsultActivityUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:splitbill.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:splitbill.Model"
    xmlns:viewmodels="clr-namespace:splitbill.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:ConsultActivityVM}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="White"
    mc:Ignorable="d">

    <!--  Fond de la page  -->
    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#F0EFFF" />
                <GradientStop Offset="0.5" Color="#FAF0FF" />
                <GradientStop Offset="1" Color="#EFF6FF" />
            </LinearGradientBrush>
        </Border.Background>

        <!--  Grille de la page  -->
        <Grid Margin="32,28,32,28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--#region  Header : Contextual Text et bouton Retour-->

            <Border Grid.Row="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        FontFamily="Segoe UI Light"
                        FontSize="26"
                        Foreground="#2D2D3A"
                        Text="Consultez activité" />

                    <!--  Bouton de navigation : CommandParameters = Vers  où le bouton mène. Dans ce cas, Retour mène à overview  -->
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Command="{Binding ReturnToOverviewCommand}"
                        Content="Retour"
                        Style="{StaticResource SecondaryButton}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="#9898B8"
                        Text="Consultez une activité" />
                </Grid>
            </Border>

            <!--#endregion-->

            <!--  Main Card  -->
            <Border
                Grid.Row="2"
                Padding="28,24"
                Background="White"
                CornerRadius="16"
                Effect="{StaticResource CardShadow}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width=".8*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>

                    <!--#region Left Column: Activity/Description/Closed/Save changes-->
                    <StackPanel Grid.Column="0">

                        <!--  Activity Name  -->
                        <Label Content="NOM DE L'ACTIVITÉ" Style="{StaticResource LabelStyle}" />
                        <TextBox
                            IsReadOnly="{Binding IsOwner, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource InputStyle}"
                            Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <!--  Activity Name  -->
                        <Label Content="DESCRIPTION DE L'ACTIVITÉ" Style="{StaticResource LabelStyle}" />
                        <TextBox
                            Height="70"
                            Margin="0"
                            Padding="0"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            IsReadOnly="{Binding IsOwner, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource InputStyle}"
                            Text="{Binding EditDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <Label
                            Content="MARQUER COMME TERMINÉE"
                            Style="{StaticResource LabelStyle}"
                            Visibility="{Binding IsOwner, Converter={StaticResource InverseBoolConverter}}" />

                        <!--  TODO: Fix ce gros bouton laid qui switch plus ou moins bien  -->
                        <ToggleButton
                            Height="30"
                            IsChecked="{Binding EditIsActive, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                            IsEnabled="{Binding IsOwner}"
                            Style="{StaticResource ToggleButtonStyle}"
                            Visibility="{Binding IsOwner, Converter={StaticResource InverseBoolConverter}}" />

                    </StackPanel>


                    <!--  Save Changes button  -->
                    <Button
                        Grid.Column="0"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Command="{Binding SaveActivityCommand}"
                        Content="✓  Modifier l'activité"
                        IsEnabled="{Binding HasUnsavedChanges}"
                        Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding IsOwner, Converter={StaticResource InverseBoolConverter}}" />

                    <!--#endregion-->

                    <!--#region  Cetner column : Section PARTICIPANTS-->

                    <!--  Border Pour mettre du padding à la colonne participante  -->
                    <Border
                        Grid.Column="1"
                        Padding="28,10,10,10"
                        Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <!--  Titre  -->
                                <RowDefinition Height="Auto" />

                                <!--  ListView  -->
                                <RowDefinition Height="*" />

                                <!--  Edit button  -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Titre  -->
                            <Label
                                Grid.Row="0"
                                Content="PARTICIPANTS"
                                Style="{StaticResource LabelStyle}" />

                            <!--  Liste de participants  -->
                            <ListView
                                Grid.Row="1"
                                d:ItemsSource="{d:SampleData ItemCount=5}"
                                ItemsSource="{Binding thisActivityVM.Participants}"
                                SelectionMode="Extended"
                                Style="{StaticResource ListViewStyle}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn
                                            Width="115"
                                            DisplayMemberBinding="{Binding Username}"
                                            Header="Sobriquet">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style BasedOn="{StaticResource ColumnHeaderStyle}" TargetType="GridViewColumnHeader" />
                                            </GridViewColumn.HeaderContainerStyle>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <!--  Edit Btn (MarginTop=10)  -->
                            <Button
                                Grid.Row="2"
                                Margin="0,10,0,0"
                                VerticalAlignment="Top"
                                Command="{Binding GoToModifyParticipantCommand}"
                                Content="Modifier"
                                IsEnabled="{Binding IsOwner}"
                                Style="{StaticResource SecondaryButton}"
                                Visibility="{Binding IsOwner, Converter={StaticResource InverseBoolConverter}}" />
                        </Grid>

                    </Border>

                    <!--#endregion-->

                    <!--#region  Right column : Section DÉPENSES-->

                    <!--  Border Pour mettre du padding à la colonne dépense  -->
                    <Border
                        Grid.Column="2"
                        Padding="10,10,28,10"
                        Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <!--  Titre  -->
                                <RowDefinition Height="Auto" />

                                <!--  Listview  -->
                                <RowDefinition Height="*" />

                                <!--  Add Btn  -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Titre  -->
                            <Label
                                Grid.Row="0"
                                Content="DÉPENSES"
                                Style="{StaticResource LabelStyle}" />

                            <!--  List de dépenses  -->
                            <ListView
                                Grid.Row="1"
                                d:ItemsSource="{d:SampleData ItemCount=5}"
                                ItemsSource="{Binding thisActivityVM.Expenses}"
                                SelectionMode="Extended"
                                Style="{StaticResource ListViewStyle}">
                                <ListView.View>
                                    <GridView>

                                        <!--#region GrViewCol Dépense.Name (Titre)-->

                                        <GridViewColumn
                                            Width="120"
                                            DisplayMemberBinding="{Binding Name}"
                                            Header="Titre">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style BasedOn="{StaticResource ColumnHeaderStyle}" TargetType="GridViewColumnHeader" />
                                            </GridViewColumn.HeaderContainerStyle>
                                        </GridViewColumn>
                                        <!--#endregion-->

                                        <!--#region GrViewCol Dépense.Amoount (💰)-->

                                        <GridViewColumn Width="50" Header="💰">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Width="45"
                                                        Height="20"
                                                        Cursor="Hand"
                                                        Text="{Binding Amount}"
                                                        ToolTip="Montant associé à cette dépense" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <!--#endregion-->

                                        <!--#region GrViewCol Afficher participants-->
                                        <GridViewColumn Width="90" Header="👥">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Width="85"
                                                        Height="20"
                                                        Cursor="Hand"
                                                        Text="{Binding Participants.Count, StringFormat={}{0} Personnes}">
                                                        <TextBlock.ToolTip>
                                                            <ToolTip>
                                                                <StackPanel>
                                                                    <TextBlock
                                                                        Margin="0,0,0,4"
                                                                        FontWeight="Bold"
                                                                        Text="Participants:" />
                                                                    <ItemsControl ItemsSource="{Binding Participants}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Username}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!--#endregion-->
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <!--  Add Btn (MarginTop=10)  -->
                            <Button
                                Grid.Row="3"
                                VerticalAlignment="Top"
                                Command="{Binding NewExpenseCommand}"
                                Content="Ajouter"
                                Style="{StaticResource SecondaryButton}" />



                        </Grid>
                    </Border>
                    <!--#endregion-->

                </Grid>
            </Border>
        </Grid>

    </Border>

</UserControl>
