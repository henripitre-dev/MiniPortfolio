<UserControl
    x:Class="splitbill.View.CreateAccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:splitbill.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:CreateAccountVM}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#F0EFFF" />
                    <GradientStop Offset="0.5" Color="#FAF0FF" />
                    <GradientStop Offset="1" Color="#EFF6FF" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <Border Grid.Row="0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontFamily="Segoe UI Light"
                                FontSize="26"
                                Foreground="#2D2D3A"
                                Text="Créer un compte" />

                            <!--  Bouton de navigation. Dans ce cas, mène à login  -->
                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Command="{Binding ReturnToLoginCommand}"
                                Content="Connexion"
                                Style="{StaticResource SecondaryButton}" />
                        </Grid>

                    </StackPanel>
                </Border>


                <!--  Card  -->
                <Border
                    Grid.Row="2"
                    Width="420"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="16"
                    Effect="{StaticResource CardShadow}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Username  -->
                        <Label
                            Grid.Row="0"
                            Content="UTILISATEUR"
                            Style="{StaticResource LabelStyle}" />

                        <TextBox
                            Grid.Row="1"
                            Style="{StaticResource InputStyle}"
                            Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Password  -->
                        <Label
                            Grid.Row="2"
                            Margin="0,10,0,0"
                            Content="MOT DE PASSE"
                            Style="{StaticResource LabelStyle}" />

                        <PasswordBox
                            Grid.Row="3"
                            PasswordChanged="PasswordBox_PasswordChanged"
                            Style="{StaticResource PasswordInputStyle}" />

                        <!--  Error  -->
                        <TextBlock
                            Grid.Row="4"
                            Margin="0,10,0,0"
                            Foreground="#E05A5A"
                            Text="{Binding ErrorMessage}"
                            Visibility="{Binding HasError, Converter={StaticResource InverseBoolConverter}}" />

                        <!--  Create Button  -->
                        <Button
                            Grid.Row="5"
                            Margin="0,20,0,0"
                            Command="{Binding CreateCommand}"
                            Content="✓ Créer le compte"
                            Style="{StaticResource PrimaryButton}" />

                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>