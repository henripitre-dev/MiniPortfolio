<Application
    x:Class="splitbill.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:splitbill.Converters"
    xmlns:local="clr-namespace:splitbill"
    xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:viewmodels="clr-namespace:splitbill.ViewModels"
    xmlns:views="clr-namespace:splitbill.View"
    StartupUri="View/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="View/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--#region Assignation des dataTempaltes Views à VM (Linker le ContentControl de SelectedVM à xaml correspondant au VM)
                *Si t'oublies de faire ça, le nom de la VM sera affichée en texte dans ta page et ne loadera pas.-->

            <DataTemplate DataType="{x:Type viewmodels:OverviewVM}">
                <views:OverviewUC />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:LoginVM}">
                <views:LoginUC />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:NewActivityVM}">
                <views:NewActivityUC />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:ConsultActivityVM}">
                <views:ConsultActivityUC />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:NewExpenseVM}">
                <views:NewExpenseUC />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:NewRefundVM}">
                <views:NewRefundUC />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:ModifyParticipantVM}">
                <views:ModifyParticipantUC />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:CreateAccountVM}">
                <views:CreateAccountWindow />
            </DataTemplate>

            <!--#endregion-->

            <converters:OwnerToCrownConverter x:Key="OwnerToCrownConverter" />

            <converters:UserBalanceToTextConverter x:Key="UserBalanceToTextConverter" />
            <converters:BalanceToColorConverter x:Key="BalanceToColorConverter" />
            <converters:RemainingConverter x:Key="RemainingConverter" />
            <converters:ExpenseToUserShareConverter x:Key="ExpenseToUserShareConverter" />

            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />

            <converters:EyeIconConverter x:Key="EyeIconConverter" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
