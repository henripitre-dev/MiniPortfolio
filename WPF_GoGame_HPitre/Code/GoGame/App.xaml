<Application
    x:Class="GoGame.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:GoGame.Converters"
    xmlns:local="clr-namespace:GoGame"
    xmlns:viewmodels="clr-namespace:GoGame.ViewModels"
    xmlns:views="clr-namespace:GoGame.View"
    StartupUri="View/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="View/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--#region Assignation des dataTempaltes Views à VM (Linker le ContentControl de SelectedVM à xaml correspondant au VM)
                *Si t'oublies de faire ça, le nom de la VM sera affichée en texte dans ta page et ne loadera pas.-->

            <DataTemplate DataType="{x:Type viewmodels:CreateGameVM}">
                <views:CreateGameUC />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:GameVM}">
                <views:GameUC />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:ResultsVM}">
                <views:ResultsWnd />
            </DataTemplate>

            <!--#endregion-->

            <converters:EnumToBoolConverter x:Key="EnumToBool" />
            <converters:StoneColorToXamlConverter x:Key="StoneColorToXaml" />
            <converters:SecondsToTextTimeConverter x:Key="SecondsToTextTime" />
            <converters:MoveToStringConverter x:Key="MoveToString" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
