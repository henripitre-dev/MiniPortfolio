<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  GÉNÉRÉ PAR IA  -->
    <!--  ================= COLORS (WOOD THEME) =================  -->

    <!--  Base tones  -->
    <Color x:Key="WoodLight">#F3E9D2</Color>
    <!--  background  -->
    <Color x:Key="WoodMedium">#E0C097</Color>
    <!--  cards  -->
    <Color x:Key="WoodDark">#A47551</Color>
    <!--  accents  -->

    <!--  Text  -->
    <Color x:Key="TextPrimary">#2B2B2B</Color>
    <Color x:Key="TextSecondary">#6B6B6B</Color>

    <!--  UI  -->
    <Color x:Key="BorderSoft">#D6C3A3</Color>
    <Color x:Key="HoverOverlay">#20FFFFFF</Color>

    <!--  Game elements  -->
    <SolidColorBrush x:Key="BlackStone" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="BlackStoneBrdr" Color="SlateGray" />
    <SolidColorBrush x:Key="WhiteStone" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="WhiteStoneBrdr" Color="DarkGoldenrod" />

    <!--  Brushes  -->
    <SolidColorBrush x:Key="WoodLightBrush" Color="{StaticResource WoodLight}" />
    <SolidColorBrush x:Key="WoodMediumBrush" Color="{StaticResource WoodMedium}" />
    <SolidColorBrush x:Key="WoodDarkBrush" Color="{StaticResource WoodDark}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />

    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoft}" />

    <!--  ================= BACKGROUND =================  -->

    <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F8F1E4" />
        <GradientStop Offset="0.5" Color="#F3E9D2" />
        <GradientStop Offset="1" Color="#EAD8B7" />
    </LinearGradientBrush>

    <!--  ================= TYPOGRAPHY =================  -->

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!--  ================= CARD =================  -->

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WoodLightBrush}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--  ================= BUTTON =================  -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource WoodDarkBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="22,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#C5B7A3" />
                            <Setter Property="Foreground" Value="#888" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="22,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#10A47551" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================= INPUT =================  -->

    <Style x:Key="InputStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="10" />
        <!--  Makes cursor "I" even when on paddig  -->
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--  Avoid bottom of text cut off  -->
        <Setter Property="MinHeight" Value="36" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================= COMBOBOX =================  -->

    <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">

                        <Grid>
                            <ContentPresenter Margin="6,0,30,0" VerticalAlignment="Center" />

                            <TextBlock
                                Margin="0,0,10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="▼" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentedButton" TargetType="ToggleButton">
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource WoodDarkBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource WoodDarkBrush}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#20A47551" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="30" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="10" />
        <Setter Property="TickFrequency" Value="0.5" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">

                    <Grid>

                        <!--  FULL TRACK (background)  -->
                        <Border
                            x:Name="TrackBackground"
                            Height="6"
                            VerticalAlignment="Center"
                            Background="#E6D7BF"
                            CornerRadius="3" />

                        <!--  FILL BAR (real progress)  -->
                        <Border
                            x:Name="PART_SelectionRange"
                            Height="6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource WoodDarkBrush}"
                            CornerRadius="3" />

                        <!--  TRACK + THUMB (WPF handles movement)  -->
                        <Track x:Name="PART_Track" VerticalAlignment="Center">

                            <Track.Thumb>
                                <Thumb
                                    Width="18"
                                    Height="18"
                                    Cursor="Hand">

                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse
                                                    Fill="White"
                                                    Stroke="{StaticResource WoodDarkBrush}"
                                                    StrokeThickness="2" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>

                                </Thumb>
                            </Track.Thumb>

                        </Track>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GoBoardStyle" TargetType="Border">
        <Setter Property="Background" Value="#D8B27A" />
        <Setter Property="BorderBrush" Value="#6B3F1D" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="GoGridLineHorizontal" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="#3A2A1A" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <Style x:Key="GoGridLineVertical" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="#3A2A1A" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <Style x:Key="GoCellButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <ContentPresenter />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BlackStoneStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Fill" Value="{StaticResource BlackStone}" />
        <Setter Property="Stroke" Value="#333" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WhiteStoneStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Fill" Value="{StaticResource WhiteStone}" />
        <Setter Property="Stroke" Value="#AAA" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="GoStarPointStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="5" />
        <Setter Property="Height" Value="5" />
        <Setter Property="Fill" Value="#3A2A1A" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>