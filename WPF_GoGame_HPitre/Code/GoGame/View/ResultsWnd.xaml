<Window
    x:Class="GoGame.View.ResultsWnd"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:GoGame.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ResultsVM}"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border
                Padding="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource WoodLightBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  HEADER  -->
                    <StackPanel>

                        <TextBlock Style="{StaticResource TitleText}" Text="🏁 Partie terminée" />

                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource SubtitleText}"
                            Text="{Binding EndReason}" />
                    </StackPanel>

                    <!--  WINNER  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,20,0,18"
                        Padding="22"
                        Background="{StaticResource WoodMediumBrush}"
                        CornerRadius="18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse
                                Width="52"
                                Height="52"
                                Fill="{Binding WinnerStoneBrush}"
                                Stroke="Black"
                                StrokeThickness="1.2" />

                            <StackPanel Grid.Column="1" Margin="16,0">

                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="GAGNANT" />

                                <TextBlock
                                    d:Text="Nom gagnant"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Text="{Binding WinnerText}" />

                                <TextBlock d:Text="résumé vicotire" Text="{Binding WinnerSummary}" />
                                <TextBlock Text=" • Le score japonais compte uniquement les territoires entourés." />
                                <TextBlock Text=" • Résultats exportés au dossier parent de la solution" />
                            </StackPanel>

                            <Border
                                Grid.Column="2"
                                Padding="12,8"
                                Background="#22000000"
                                CornerRadius="10">

                                <TextBlock
                                    VerticalAlignment="Center"
                                    d:Text="XXXX"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Text="{Binding ScoreDifferenceText}" />
                            </Border>

                        </Grid>

                    </Border>

                    <!--  CONTENT  -->
                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!--  PLAYERS  -->
                        <Border
                            Margin="0,0,12,0"
                            Padding="18"
                            Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock
                                    Margin="0,0,0,14"
                                    Style="{StaticResource LabelStyle}"
                                    Text="👥 Joueurs" />

                                <!--  BLACK  -->
                                <Grid Margin="0,0,0,16">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Top"
                                        Fill="Black" />

                                    <StackPanel Grid.Column="1" Margin="10,0">

                                        <TextBlock
                                            d:Text="Nom noir"
                                            FontWeight="SemiBold"
                                            Text="{Binding BlackPlayerName}" />

                                        <TextBlock
                                            d:Text="tps noir"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="{Binding BlackPlayerTime}" />

                                        <TextBlock
                                            d:Text="nb territorires noir"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="{Binding BlackTerritoryText}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        d:Text="XX.X"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Text="{Binding BlackScore}" />

                                </Grid>

                                <!--  WHITE  -->
                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Top"
                                        Fill="White"
                                        Stroke="Black" />

                                    <StackPanel Grid.Column="1" Margin="10,0">

                                        <TextBlock
                                            d:Text="Nom blanc"
                                            FontWeight="SemiBold"
                                            Text="{Binding WhitePlayerName}" />

                                        <TextBlock
                                            d:Text="tps blanc"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="{Binding WhitePlayerTime}" />

                                        <TextBlock
                                            d:Text="nb territorires blanc"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="{Binding WhiteTerritoryText}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        d:Text="XX.X"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Text="{Binding WhiteScore}" />

                                </Grid>

                            </StackPanel>
                        </Border>

                        <!--  STATS  -->
                        <StackPanel Grid.Column="1">

                            <Border
                                Margin="0,0,0,12"
                                Padding="18"
                                Style="{StaticResource CardStyle}">

                                <StackPanel>

                                    <TextBlock
                                        Margin="0,0,0,12"
                                        Style="{StaticResource LabelStyle}"
                                        Text="📊 Statistiques" />

                                    <TextBlock d:Text="Nombre de coups" Text="{Binding TotalMovesText}" />
                                    <TextBlock d:Text="Taille du plateau" Text="{Binding BoardSizeText}" />
                                    <TextBlock d:Text="Komi" Text="{Binding KomiText}" />

                                    <TextBlock d:Text="Handicap" Text="{Binding HandicapText}" />
                                    <TextBlock d:Text="Durée" Text="{Binding TotalDurationText}" />

                                </StackPanel>

                            </Border>

                            <Border
                                Padding="18"
                                Background="#12A47551"
                                CornerRadius="14">

                                <TextBlock
                                    d:Text="Conclusion gagnant"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{Binding SummaryText}"
                                    TextWrapping="Wrap" />

                            </Border>

                        </StackPanel>

                    </Grid>

                    <!--  ACTIONS  -->
                    <StackPanel
                        Grid.Row="3"
                        Margin="0,22,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                        <Button
                            Width="170"
                            Margin="0,0,10,0"
                            Command="{Binding NewGameCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="Nouvelle partie"
                            Style="{StaticResource PrimaryButton}" />

                        <Button
                            Width="170"
                            Margin="0,0,10,0"
                            Command="{Binding ReplayCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="Rejouer paramètres"
                            Style="{StaticResource SecondaryButton}" />

                        <Button
                            Width="170"
                            Margin="0,0,10,0"
                            Command="{Binding CloseCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="Fermer"
                            Style="{StaticResource SecondaryButton}" />

                        <Button
                            Width="120"
                            Command="{Binding QuitCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="Quitter"
                            Style="{StaticResource SecondaryButton}" />

                    </StackPanel>

                </Grid>

            </Border>
        </ScrollViewer>
    </Grid>

</Window>