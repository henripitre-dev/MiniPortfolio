<UserControl
    x:Class="GoGame.View.CreateGameUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:GoGame.Model.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:GoGame.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:CreateGameVM}"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppBackground}">

        <!--  BACKGROUND  -->
        <Ellipse
            Width="400"
            Height="400"
            Margin="-180,-180,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Fill="#30A47551" />

        <Ellipse
            Width="400"
            Height="400"
            Margin="200,30,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Fill="#20A47551" />

        <Ellipse
            Width="300"
            Height="300"
            Margin="0,0,-120,-120"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Fill="#60A47551" />

        <Grid>

            <!--  MAIN  -->
            <Grid
                Width="560"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  HEADER  -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleText}" Text="UNLEASHED GO" />

                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource SubtitleText}"
                            Text="Créer une nouvelle partie" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Command="{Binding QuitCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="Quitter"
                        Style="{StaticResource SecondaryButton}" />
                </Grid>

                <!--  CARD  -->
                <Border
                    Grid.Row="1"
                    Padding="28"
                    Background="White"
                    Style="{StaticResource CardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel>

                            <!--  PLAYERS  -->
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <!--  BLACK  -->
                                <Border
                                    Padding="14"
                                    Background="#111"
                                    CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="NOIR" />

                                        <TextBox
                                            Height="34"
                                            Margin="0,8,0,0"
                                            Background="#1E1E1E"
                                            Foreground="White"
                                            Style="{StaticResource InputStyle}"
                                            Text="{Binding PlayerBlackName}" />
                                    </StackPanel>
                                </Border>

                                <!--  WHITE  -->
                                <Border
                                    Grid.Column="2"
                                    Padding="14"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="BLANC" />

                                        <TextBox
                                            Height="34"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource InputStyle}"
                                            Text="{Binding PlayerWhiteName}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!--  SIZE  -->
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Taille du plateau" />

                                <UniformGrid
                                    Width="300"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    Columns="3">

                                    <RadioButton
                                        Height="38"
                                        Content="9×9"
                                        GroupName="BoardSize"
                                        IsChecked="{Binding SelectedBoardSize, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:BoardSize.Small9}}"
                                        Style="{StaticResource SegmentedButton}" />

                                    <RadioButton
                                        Height="38"
                                        Content="13×13"
                                        GroupName="BoardSize"
                                        IsChecked="{Binding SelectedBoardSize, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:BoardSize.Medium13}}"
                                        Style="{StaticResource SegmentedButton}"
                                        ToolTip="Cette taille de plateau n'est pas encore disponible." />

                                    <RadioButton
                                        Height="38"
                                        Content="19×19"
                                        GroupName="BoardSize"
                                        IsChecked="{Binding SelectedBoardSize, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:BoardSize.Large19}}"
                                        Style="{StaticResource SegmentedButton}"
                                        ToolTip="Cette taille de plateau n'est pas encore disponible." />
                                </UniformGrid>
                            </StackPanel>

                            <!--  KOMI  -->
                            <Border
                                Margin="0,0,0,20"
                                Padding="16"
                                Background="{StaticResource WoodLightBrush}"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="14">

                                <StackPanel>

                                    <!--  HEADER  -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Style="{StaticResource LabelStyle}"
                                            Text="Komi" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Opacity="0.8"
                                            Text="Compensation pour le joueur blanc" />

                                        <Border
                                            Grid.Column="2"
                                            Padding="10,4"
                                            Background="{StaticResource WoodDarkBrush}"
                                            CornerRadius="8">

                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding Komi, StringFormat={}{0:F1}}" />
                                        </Border>
                                    </Grid>
                                    <!--  SLIDER  -->
                                    <Slider
                                        Margin="0,10,0,0"
                                        IsSnapToTickEnabled="True"
                                        Maximum="9.5"
                                        Minimum="0.5"
                                        Style="{StaticResource SliderStyle}"
                                        TickFrequency="1"
                                        Value="{Binding Komi}" />

                                </StackPanel>
                            </Border>

                            <!--  HANDICAP  -->
                            <Border
                                Margin="0,0,0,20"
                                Padding="16"
                                Background="White"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="14">

                                <StackPanel>

                                    <!--  HEADER  -->

                                    <TextBlock
                                        Padding="0,0,0,8"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Style="{StaticResource LabelStyle}"
                                        Text="Handicap" />

                                    <!--  OPTIONS  -->
                                    <!--  TODO: DYNAMISER SELON BOARD SIZE  -->
                                    <UniformGrid Columns="6">

                                        <RadioButton
                                            Height="38"
                                            Background="LightGray"
                                            Content="0"
                                            GroupName="Handicap"
                                            IsChecked="{Binding NbHandicaps, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:Handicaps.None}}"
                                            Style="{StaticResource SegmentedButton}" />

                                        <RadioButton
                                            Height="38"
                                            Background="LightGray"
                                            Content="1"
                                            GroupName="Handicap"
                                            IsChecked="{Binding NbHandicaps, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:Handicaps.One}}"
                                            Style="{StaticResource SegmentedButton}" />

                                        <RadioButton
                                            Height="38"
                                            Background="LightGray"
                                            Content="2"
                                            GroupName="Handicap"
                                            IsChecked="{Binding NbHandicaps, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:Handicaps.Two}}"
                                            Style="{StaticResource SegmentedButton}" />

                                        <RadioButton
                                            Height="38"
                                            Background="LightGray"
                                            Content="3"
                                            GroupName="Handicap"
                                            IsChecked="{Binding NbHandicaps, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:Handicaps.Three}}"
                                            Style="{StaticResource SegmentedButton}" />

                                        <RadioButton
                                            Height="38"
                                            Background="LightGray"
                                            Content="4"
                                            GroupName="Handicap"
                                            IsChecked="{Binding NbHandicaps, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:Handicaps.Four}}"
                                            Style="{StaticResource SegmentedButton}" />

                                        <RadioButton
                                            Height="38"
                                            Background="LightGray"
                                            Content="5"
                                            GroupName="Handicap"
                                            IsChecked="{Binding NbHandicaps, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:Handicaps.Five}}"
                                            Style="{StaticResource SegmentedButton}" />
                                    </UniformGrid>

                                    <!--  DESCRIPTION  -->
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Ajoute des pierres noires de départ pour équilibrer la partie."
                                        TextWrapping="Wrap" />

                                </StackPanel>
                            </Border>

                            <!--  INFO  -->
                            <Border
                                Margin="0,0,0,18"
                                Padding="10"
                                Background="#12A47551"
                                CornerRadius="10">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="Black"
                                    Text="Note : seule la taille de plateau 9×9 est actuellement disponible."
                                    TextWrapping="Wrap" />
                            </Border>

                            <!--  ACTIONS  -->
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    Command="{Binding GoBackCommand}"
                                    Content="Annuler"
                                    Style="{StaticResource SecondaryButton}" />

                                <Button
                                    Command="{Binding StartGameCommand}"
                                    Content="Démarrer"
                                    IsEnabled="{Binding CanStartGame}"
                                    Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>